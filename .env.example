# ตัวอย่าง Environment Variables (ไม่มีค่าจริง) — คัดลอกเป็น .env.local แล้วใส่ค่าของโปรเจกต์
# Supabase Dashboard → Project Settings → API

# ใช้ร่วมกันทั้ง 2 ระบบ
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# ระบบเบิกสินค้า Aemori (เดิม) — รหัสกลางสำหรับ /admin
ADMIN_ACCESS_PASSWORD=<รหัสกลางผู้ดูแลระบบเดิม>
ADMIN_SESSION_SECRET=<ข้อความสุ่มยาวอย่างน้อย 32 ตัวอักษร>

# ระบบแจ้งสินค้าใกล้หมด (ใหม่) — ใช้ฝั่ง server เท่านั้น ห้ามขึ้นต้นด้วย NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=<service-role-secret-key>
